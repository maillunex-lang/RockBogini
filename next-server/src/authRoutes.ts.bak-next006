import type {FastifyInstance} from 'fastify';
import type {Storage} from './storage.js';
import {randomBytes,randomUUID} from 'node:crypto';
import {hashPassword,verifyPassword,tokenHash,createGuest,sessionAccount} from './auth.js';
export async function authRoutes(app:FastifyInstance,s:Storage){
 const dummy=await hashPassword(randomBytes(32).toString('hex'));
 const credentials={type:'object',additionalProperties:false,required:['email','password'],properties:{email:{type:'string',maxLength:254,pattern:'^[^ @]+@[^ @]+[.][^ @]+$'},password:{type:'string',minLength:10,maxLength:128}}} as const;
 type Cred={email:string;password:string};
 const bearer=(h:string|undefined)=>/^Bearer ([A-Za-z0-9_-]{43})$/.exec(h??'')?.[1];
 app.addHook('preHandler',async(req,reply)=>{if(!req.url.startsWith('/v1/auth/'))return;const key='auth:rate:'+req.ip;const n=Number(await s.redis.eval("local n=redis.call('INCR',KEYS[1]); if n==1 then redis.call('EXPIRE',KEYS[1],60) end; return n",{keys:[key],arguments:[]}));if(n>30)return reply.code(429).send({error:'rate_limit'})});
 app.post('/v1/auth/guest',async()=>createGuest(s));
 app.post<{Body:Cred}>('/v1/auth/register',{schema:{body:credentials}},async(req,reply)=>{
 const id=randomUUID(),token=randomBytes(32).toString('base64url'),hash=await hashPassword(req.body.password);const c=await s.pg.connect();
 try{await c.query('BEGIN');await c.query('INSERT INTO accounts(id,email,password_hash) VALUES($1,$2,$3)',[id,req.body.email.toLowerCase(),hash]);await c.query("INSERT INTO sessions VALUES($1,$2,now()+interval '365 days')",[tokenHash(token),id]);await c.query('COMMIT');return reply.code(201).send({id,token})}catch(e){await c.query('ROLLBACK');if((e as {code?:string}).code==='23505')return reply.code(409).send({error:'account_exists'});throw e}finally{c.release()}
 });
 app.post<{Body:Cred}>('/v1/auth/login',{schema:{body:credentials}},async(req,reply)=>{
 const r=await s.pg.query('SELECT id,password_hash FROM accounts WHERE email=$1',[req.body.email.toLowerCase()]);const a=r.rows[0];const valid=await verifyPassword(req.body.password,a?.password_hash??dummy);if(!a||!valid)return reply.code(401).send({error:'invalid_credentials'});
 const token=randomBytes(32).toString('base64url');await s.pg.query("INSERT INTO sessions VALUES($1,$2,now()+interval '365 days')",[tokenHash(token),a.id]);return {id:a.id,token};
 });
 app.get('/v1/auth/session',async(req,reply)=>{const t=bearer(req.headers.authorization);const id=t&&await sessionAccount(s,t);if(!id)return reply.code(401).send({error:'invalid_session'});return {id}});
 app.post('/v1/auth/logout',async(req,reply)=>{const t=bearer(req.headers.authorization);if(t)await s.pg.query('DELETE FROM sessions WHERE token_hash=$1',[tokenHash(t)]);return reply.code(204).send()});
}
